# ==============================================================================
# TELEGRAM CHANNEL CURATOR & AI REWRITER - CONFIGURATION
# ==============================================================================
# 1. Telegram API credentials from https://my.telegram.org/apps
# 2. Never commit your actual .env file to Git!
# ==============================================================================

# Telegram MTProto Credentials
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+989123456789
SESSION_NAME=channel_curator_session

# Target Telegram Channel (Where rewritten posts will be published)
# Example: @MyTechChannel or channel ID like -1001234567890
TARGET_CHANNEL=@MyTechNewsChannel

# Admin Telegram ID (Who receives draft approval previews in review mode)
ADMIN_USER_ID=123456789

# Default Publishing Mode:
# 'review' = Human-in-the-Loop draft approval via Telegram inline keyboard buttons
# 'auto'   = Instantly publish rewritten posts to TARGET_CHANNEL
PUBLISHING_MODE=review

# ==============================================================================
# LLM AI REWRITER CONFIGURATION (OpenAI / DeepSeek / OpenRouter / Ollama)
# ==============================================================================
# If OPENAI_API_KEY is left empty, the bot automatically falls back to
# the Rule-Based template cleaner (which strips links, reformats, and adds tags).
OPENAI_API_KEY=sk-your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Example for DeepSeek: https://api.deepseek.com
# Example for OpenRouter: https://openrouter.ai/api/v1
LLM_MODEL_NAME=gpt-4o-mini

# Default AI rewriting instructions
DEFAULT_LLM_PROMPT="Rewrite the following Telegram post in Persian with an engaging, professional tone. Summarize the key takeaways, remove external URLs and competitor IDs, add 2-3 relevant hashtags, and keep it clean."

# Channel Signature footer appended to published posts
CHANNEL_SIGNATURE=@MyTechNewsChannel

# Database and Log Paths
DATABASE_PATH=data/curator.db
LOG_LEVEL=INFO
